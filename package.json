{
  "name": "gravity-shift",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm test && npm run build",
    "dev": "node scripts/dev.mjs",
    "package": "npm run build && python3 scripts/package-source.py",
    "format": "prettier --write src styles.css scripts/*.mjs tests/*.cjs tailwind.config.cjs README.md docs/*.md"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17"
  }
}
