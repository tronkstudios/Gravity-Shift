{
  "name": "gravity-shift",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm test && npm run build",
    "dev": "node scripts/dev.mjs",
    "package": "npm run build && python3 scripts/package-source.py",
    "format": "prettier --write src styles.css scripts/*.mjs tests/*.cjs tailwind.config.cjs README.md docs/*.md",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.10",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17"
  }
}
